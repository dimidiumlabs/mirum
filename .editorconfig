root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
# double whitespace at end of line
# denotes a line break in Markdown
trim_trailing_whitespace = false

[*.rs]
max_line_length = 100

[*.yml]
indent_size = 2

[{Makefile,*.mk}]
indent_style = tab
